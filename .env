# Local server / LAN demo address
HOST=0.0.0.0
PORT=8000
APP_IP=127.0.0.1

# Only self-hosted components are permitted in the protected contour.
STT_PROVIDER=local_whisper
DIARIZATION_PROVIDER=local_pyannote
LLM_PROVIDER=local_llama
LLAMA_URL=http://127.0.0.1:8080
LLAMA_MODEL=gemma-4-12b-it-Q4_K_S
LLAMA_TIMEOUT=600
# Settings for start.cmd (Gemma and API run together in WSL).
LLAMA_MODEL_PATH=models/llm/gemma-4-12b-it-Q4_K_S.gguf
LLAMA_PORT=8080
LLAMA_GPU_LAYERS=0
LLAMA_STARTUP_TIMEOUT=600

# Device used by the bundled Kazakh/Russian mixed STT module.
STT_DEVICE=cuda
