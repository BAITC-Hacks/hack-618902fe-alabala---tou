# Local server / LAN demo address
HOST=0.0.0.0
PORT=8000
APP_IP=127.0.0.1

# Only self-hosted components are permitted in the protected contour.
STT_PROVIDER=local_whisper
DIARIZATION_PROVIDER=local_pyannote
LLM_PROVIDER=local_llama

# Device used by the bundled Kazakh/Russian mixed STT module.
STT_DEVICE=cuda
