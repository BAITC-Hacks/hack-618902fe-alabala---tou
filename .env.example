# Address at which the local demo server listens.
HOST=0.0.0.0
PORT=8000
# Replace with the LAN address of the machine for a shared demo.
APP_IP=127.0.0.1
STT_PROVIDER=local_rukk
DIARIZATION_PROVIDER=local_nemo
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=Gemma-4-12B-it-Q6_K:latest
OLLAMA_TIMEOUT=180
APP_TIMEZONE=Asia/Qyzylorda
STT_DIARIZE=true
MAX_UPLOAD_MB=256
MAX_AUDIO_SECONDS=7200
AUDIO_DECODE_TIMEOUT=300
FFMPEG_BINARY=ffmpeg
# Optional paths to Unicode TrueType fonts for PDF export.
# REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# REPORT_FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Bundled Kazakh/Russian mixed STT module: use cuda in the production GPU contour.
STT_DEVICE=cuda
