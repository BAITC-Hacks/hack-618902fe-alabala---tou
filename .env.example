# Frontend and audio API share this server address and port.
# Use 127.0.0.1 for access only from this machine; 0.0.0.0 also listens on LAN.
HOST=0.0.0.0
PORT=8000
# Open http://127.0.0.1:8000 locally, or http://<server-LAN-IP>:8000 remotely.
# No separate APP_IP/API URL: the browser uses the page's origin.
STT_PROVIDER=local_rukk
DIARIZATION_PROVIDER=local_nemo
LLM_PROVIDER=local_llama
# llama.cpp serving gemma-4-12b-it-Q6_K.gguf; LLAMA_MODEL must match --alias.
LLAMA_URL=http://127.0.0.1:8080
LLAMA_MODEL=gemma-4-12b-it-Q6_K
LLAMA_TIMEOUT=600
# start.cmd: local GGUF path (Windows drive paths are accepted).
LLAMA_MODEL_PATH=models/llm/gemma-4-12b-it-Q6_K.gguf
LLAMA_PORT=8080
LLAMA_GPU_LAYERS=0
LLAMA_STARTUP_TIMEOUT=600
# Optional path to an existing Linux llama-server; otherwise a pinned CPU build is used.
# LLAMA_SERVER_BINARY=/opt/llama.cpp/llama-server
APP_TIMEZONE=Asia/Qyzylorda
STT_DIARIZE=true
MAX_UPLOAD_MB=256
MAX_AUDIO_SECONDS=7200
AUDIO_DECODE_TIMEOUT=300
FFMPEG_BINARY=ffmpeg
# Optional paths to Unicode TrueType fonts for PDF export.
# REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# REPORT_FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Bundled Kazakh/Russian mixed STT module: use cuda in the production GPU contour.
STT_DEVICE=cuda
